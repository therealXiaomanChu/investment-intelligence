# Run from the project directory. The default persists under ./data/.
DATABASE_URL=sqlite:///data/intelligence.sqlite3
OUTPUT_DIR=output
TIMEZONE=America/New_York
FETCH_LIMIT=100
# WATCHLIST_FILE=config/watchlist.private.yaml
# CONFIG_DIR=config

# Supply your real organization/name and a monitored contact for SEC fair access.
SEC_USER_AGENT=
OPENALEX_API_KEY=
BLS_API_KEY=
FRED_API_KEY=

# Optional AI commentary. Factual alerts work with LLM_API_KEY empty.
# Choose a base URL and that provider's API key and model. Rates are USD per million tokens.
# Examples: https://api.x.ai/v1, https://api.deepseek.com, https://api.anthropic.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_VERSION=
LLM_INPUT_USD_PER_M=
LLM_OUTPUT_USD_PER_M=
LLM_NEWS_MODEL=
LLM_NEWS_MODEL_VERSION=
LLM_NEWS_INPUT_USD_PER_M=
LLM_NEWS_OUTPUT_USD_PER_M=
LLM_DAILY_USD=0.50
LLM_MONTHLY_USD=10
LLM_MAX_CALLS=5

# Gmail shortcut: set these two values to email yourself using a Gmail app password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# alerts = material changes. all = alerts plus scheduled reports.
EMAIL_SCOPE=alerts
# Other providers: use their SMTP details and an authorized sender. Valid TLS modes are starttls and ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
