# Run from the project directory. The default persists under ./data/.
DATABASE_URL=sqlite:///data/intelligence.sqlite3
OUTPUT_DIR=output
TIMEZONE=America/New_York
FETCH_LIMIT=100
# WATCHLIST_FILE=config/watchlist.private.yaml
# CONFIG_DIR=config

# Supply your real organization/name and a monitored contact for SEC fair access.
SEC_USER_AGENT=
OPENALEX_API_KEY=
BLS_API_KEY=
FRED_API_KEY=

# Optional OpenAI-compatible text analysis. Enter your provider's actual maximum billable rates.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_VERSION=
LLM_INPUT_USD_PER_M=
LLM_OUTPUT_USD_PER_M=
LLM_NEWS_MODEL=
LLM_NEWS_MODEL_VERSION=
LLM_NEWS_INPUT_USD_PER_M=
LLM_NEWS_OUTPUT_USD_PER_M=
LLM_DAILY_USD=0.50
LLM_MONTHLY_USD=10
LLM_MAX_CALLS=5

# Markdown works with all SMTP fields empty. TLS modes are starttls and ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
